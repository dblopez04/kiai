# Copy to .env and fill in. `docker compose` reads this file; so does `npm run server`.

# Your osu! username or user id: the one player whose scores are kept.
OSU_USER=

# osu! OAuth application: https://osu.ppy.sh/home/account/edit#oauth
# Any application name and callback URL work; only public data is read (no sign-in with osu!).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Database. docker compose sets DATABASE_URL itself from POSTGRES_PASSWORD; set DATABASE_URL
# only when running the server outside compose (e.g. against `npm run db:up`).
# Letters and digits only: it's embedded in a connection URL.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://kiai:kiai@localhost:55432/kiai

# The score library has no login. It answers only to IPs, localhost, single-label names
# (homelab) and .local/.lan/.home.arpa/.internal/.ts.net names. Add any other private name
# you use to reach it here, comma-separated. Never put a public tunnel hostname here.
# PRIVATE_HOSTS=lab.example.internal

# Optional
# PORT=8080
# RECENT_WINDOW_HOURS=24         # how far back "Sync recent" looks
# SYNC_INTERVAL_HOURS=12         # queue a recent sync this often; 0 disables
# LOCAL_PP=true                  # rosu-pp estimates for loved/unranked/deleted plays
# BACKFILL_ZERO_PP_ON_SYNC=false # recalculate scores stored with exactly 0 PP after each sync
# EXPORT_DIR=data/exports        # CSV snapshots after every successful sync
# MATCH_DISCOVERY=true           # crawl osu!'s lobby and ranked play lists for your new matches

# ---------- Replays and rendering ----------

# `kiai render` sends this with uploads (set it there with: kiai server set <url> --token <this>).
# Uploads are refused until it's set. Generate one with: openssl rand -hex 24
UPLOAD_TOKEN=

# Optional
# DATA_DIR=data                  # uploaded replays, videos, and the beatmaps and skins danser reads
# MAP_MIRRORS=https://catboy.best/d/{set},https://api.nerinyan.moe/d/{set},https://osu.direct/api/d/{set}
# RENDER_ENCODER=h264_nvenc      # the cpu profile uses libx264; hevc_nvenc, h264_qsv, h264_amf, ... work too
# RENDER_CONCURRENCY=1           # renders at once per worker
# RENDER_TIMEOUT_MINUTES=60      # stop and fail a render that takes longer
# RENDER_XVFB=true               # run danser under xvfb-run, as the render image does
# RENDER_GL=software             # gpu: danser's OpenGL on the GPU via VirtualGL (the nvidia profile sets it)
# DANSER_DIR=/opt/danser         # set by the render image

# ---------- Public replay pages and notifications ----------

# The public replay app's address as viewers see it (the tunnel's hostname). Used for links in
# Discord messages and the video tags that make Discord play replays inline.
# PUBLIC_URL=https://replays.example.com
# PUBLIC_PORT=8081               # the public app's port: the only one Caddy/the tunnel reach

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels). Point the tunnel's public hostname
# at http://caddy:80, then: docker compose --profile tunnel up -d
# TUNNEL_TOKEN=

# Discord notifications when a render finishes or fails. Either a DM from your own bot (it must
# share a server with you; webhooks can't DM)...
# DISCORD_BOT_TOKEN=
# DISCORD_USER_ID=               # Developer Mode → right-click yourself → Copy User ID
# ...or a webhook into a private channel:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...